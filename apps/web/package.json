{
  "name": "@sih/web",
  "version": "0.1.0",
  "private": true,
  "description": "Next.js frontend for the voice-enabled scheme eligibility matcher",
  "scripts": {
    "dev": "dotenv -e ../../.env -- sh -c 'next dev --port ${WEB_PORT:-3000}'",
    "build": "next build",
    "start": "dotenv -e ../../.env -- sh -c 'next start --port ${WEB_PORT:-3000}'",
    "lint": "next lint --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf .next .turbo"
  },
  "dependencies": {
    "@sih/shared": "*",
    "clsx": "^2.1.1",
    "next": "^14.2.21",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.21",
    "postcss": "^8.4.49",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
