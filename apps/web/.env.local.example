# Next.js only exposes variables prefixed with NEXT_PUBLIC_ to the browser, and it
# loads .env files from this directory rather than the repo root — so this is the
# one place a second env file is genuinely needed.
#
# Everything else the web app needs (WEB_PORT) comes from the root .env, which the
# dev/start scripts load explicitly.
#
# Copy to .env.local (`npm run setup` does this for you).
#
# Note: this value is inlined into the client bundle at build time, so change it
# and rebuild — editing it will not affect an already-built app.

NEXT_PUBLIC_API_URL=http://localhost:4000/api
