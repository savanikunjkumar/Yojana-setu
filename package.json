{
  "name": "sih-scheme-matcher",
  "version": "0.1.0",
  "private": true,
  "description": "Voice-enabled government scheme eligibility matcher (Smart India Hackathon 2026)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=20.11.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rimraf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,yml,yaml,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,yml,yaml,css}\"",
    "setup": "node scripts/setup.mjs",
    "demo:ready": "node scripts/demo-ready.mjs",
    "db:up": "node scripts/compose.mjs up -d postgres",
    "db:down": "node scripts/compose.mjs down",
    "db:nuke": "node scripts/compose.mjs down -v",
    "db:logs": "node scripts/compose.mjs logs -f postgres",
    "db:migrate": "npm run prisma:migrate --workspace @sih/api",
    "db:deploy": "npm run prisma:deploy --workspace @sih/api",
    "db:reset": "npm run prisma:reset --workspace @sih/api",
    "db:seed": "npm run prisma:seed --workspace @sih/api",
    "db:studio": "npm run prisma:studio --workspace @sih/api",
    "db:generate": "npm run prisma:generate --workspace @sih/api",
    "db:psql": "node scripts/compose.mjs exec -it postgres psql -U sih -d sih_schemes",
    "scrape": "npm run scrape --workspace @sih/api --",
    "scrape:rules": "npm run scrape --workspace @sih/api -- --normalizer=rules",
    "scrape:dry": "npm run scrape --workspace @sih/api -- --dry-run",
    "scrape:test": "npm run scrape:test --workspace @sih/api",
    "backfill": "npm run backfill --workspace @sih/api --",
    "db:verify": "node scripts/compose.mjs exec -T postgres psql -U sih -d sih_schemes -v ON_ERROR_STOP=1 -q -o /dev/null < apps/api/prisma/sql/verify-matching.sql"
  },
  "devDependencies": {
    "dotenv-cli": "^8.0.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 100,
    "semi": true,
    "tabWidth": 2
  }
}
