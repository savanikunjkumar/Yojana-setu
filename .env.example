# ---------------------------------------------------------------------------
# Single source of truth for local development.
# Copy to `.env` (`npm run setup` does this for you) and never commit `.env`.
#
# Consumed by:
#   - docker-compose.yml  (POSTGRES_*)
#   - Prisma CLI          (DATABASE_URL, via `dotenv -e ../../.env --`)
#   - NestJS API          (DATABASE_URL, PORT, ...)
# ---------------------------------------------------------------------------

# --- Postgres container ---
POSTGRES_USER=sih
POSTGRES_PASSWORD=sih_dev_password
POSTGRES_DB=sih_schemes
POSTGRES_PORT=5432
ADMINER_PORT=8080

# --- Prisma / API ---
# Must line up with the POSTGRES_* values above.
DATABASE_URL="postgresql://sih:sih_dev_password@localhost:5432/sih_schemes?schema=public"

# --- LLM (scheme normalisation + voice profile extraction) ---
# Any OpenAI-compatible endpoint. One client serves both features.
# Note: pick a model that supports strict `json_schema` structured output if you can —
# on Groq, openai/gpt-oss-120b does and llama-3.3-70b-versatile does not. The client
# degrades to JSON-object mode automatically either way.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# --- Voice extraction model (independent of the scraper's) ---
# Separate for latency, not preference: Groq rate-limits PER MODEL, so sharing one model
# between a background scrape and the interactive voice path makes them compete for a single
# tokens-per-minute bucket. Also prefer a non-reasoning model here — gpt-oss emits
# chain-of-thought before answering, which costs seconds. Falls back to LLM_* if unset.
VOICE_LLM_MODEL=llama-3.3-70b-versatile
VOICE_LLM_TIMEOUT_MS=8000

# --- Voice layer (all optional) ---
# Sarvam powers Indian-language speech: Saaras for STT, Bulbul for TTS. Without it the
# app falls back to Whisper plus the browser's own speech synthesis, and stays fully
# usable — the microphone still works.
SARVAM_API_KEY=
# Leave WHISPER_BASE_URL unset to reuse LLM_BASE_URL/LLM_API_KEY above; Groq serves
# whisper-large-v3-turbo, so the fallback needs no extra credentials.
# WHISPER_BASE_URL=
WHISPER_MODEL=whisper-large-v3-turbo

NODE_ENV=development
# Port for the NestJS API.
PORT=4000
# Port for the Next.js web app. Change both this and CORS_ORIGINS together if
# something else on your machine already owns 3000.
WEB_PORT=3000
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
# Turn Swagger UI (/api/docs) on or off.
ENABLE_SWAGGER=true
LOG_LEVEL=debug
